# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

.vercel
.env*

# real customer PII source data - not for git history
docs/DigitalFlyer_Legacy_Reactivation_Candidates_1.xlsx

# Reactivation campaign runtime artifacts (contain recipient data)
scripts/.reactivation-cohort.json
scripts/.reactivation-email-preview.html

# Supabase CLI local link state
supabase/.temp/

.vercel
.env*

# Vendor API reference kept locally. The Bob Go Postman collection ships
# with a live bearer token inside it, and a token in a git history is a
# token that has leaked, even if a later commit removes it.
BobGo/
